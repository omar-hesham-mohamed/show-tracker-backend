DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/show_tracker"
PORT=3000
# Comma-separated list of allowed browser origins for the web app (Expo web
# dev server / deployed Vercel-Netlify domain). Native mobile requests don't
# go through CORS, so this only matters for the web target.
ALLOWED_ORIGINS="http://localhost:8081"
# 64+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET="change-me"
# TMDB v4 API Read Access Token (not the v3 API key) — from themoviedb.org account settings > API
TMDB_ACCESS_TOKEN="change-me"
